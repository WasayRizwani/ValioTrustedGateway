VALIO_BASE_URL=https://junction26.valioaimo.fi
VALIO_API_KEY=
GATEWAY_PORT=8787
GATEWAY_PUBLIC_URL=http://localhost:8787
# PostgreSQL connection string (used in production / Docker / Aiven; falls back to embedded PGlite when unset)
# DATABASE_URL=postgresql://valio:valio@localhost:5432/valio_gateway
# PROJECT_CA_CERT=
VOICE_MOCK_MODE=false
VOICE_PUBLIC_NUMBER=
VOICE_APPROVAL_BASE_URL=http://localhost:8787
VAPI_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
VOICE_CALLER_MAP_JSON={}
CLAIM_KEY_ID=demo-key-01
# Per-customer demo API keys (bound to customer_id — not spoofable via body)
DEMO_API_KEY_HOTEL=hotel_demo_key_001
DEMO_API_KEY_SCHOOL=school_demo_key_001
# Buyer (human-side) keys: the ONLY credentials that may approve / override / change the mandate
DEMO_BUYER_KEY_HOTEL=hotel_buyer_key_001
DEMO_BUYER_KEY_SCHOOL=school_buyer_key_001
# Agent team credentials (least privilege: each key is scoped to ONE agent role)
DEMO_AGENT_KEY_SOURCING=hotel_sourcing_key_001
DEMO_AGENT_KEY_PLANNER=hotel_planner_key_001
DEMO_AGENT_KEY_PROCUREMENT=hotel_procurement_key_001
DEMO_AGENT_KEY_VALIO=valio_account_key_001

# Purchasing agent LLM (optional — without a key, a deterministic tool agent still runs)
# Google Gemini (Gemini 4 Argon / Gemini 3.8 Flash):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon
LLM_REASONING_EFFORT=low
# Or Verda / OpenAI / Anthropic:
# OPENAI_BASE_URL=https://inference.verda.com/v1
# OPENAI_API_KEY=
# LLM_MODEL=kimi-k3-1-pro
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
